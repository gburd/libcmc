# test/proc/crossrpc.c: each node dials the other, so one pair of nodes
# has two TCP connections.  The byte a node reads back on the connection
# it dialled is the peer's answer 'A' (65), never the peer's request 'Q'.
[target]
nodes = 2
[invariants]
reply_is_answer = "node[0][0] != 81 and node[1][0] != 81"
answered = "eventually node[0][0] == 65 and node[1][0] == 65"
