# test/spec/fair/mono.cml: an action property, TLA+'s [][E]_vars.  inc
# counts x up to 3 and wrap sets it back to 0, so x' >= x fails on the
# wrap step, the fourth.  stay changes nothing, a stutter, which
# [E]_vars allows.  test/spec_gate.sh adds constraints and a holding
# property to this module.
module mono
var x : 0 .. 3
var y : 0 .. 2
init x == 0 and y == 0
action inc:
  when x < 3
  x' = x + 1
action wrap:
  when x == 3 and y < 2
  x' = 0
  y' = y + 1
action stay:
  when x == 3 and y == 2
  x' = x
deadlock = off
property monotone: always [x' >= x or (y' > y and x' == 0)]_vars
property ymono: always [y' >= y]_vars
