# test/spec/ind/escape.cml: an invariant claimed inductive whose step
# leaves the declared types and nothing else.  y stays 0 in every
# reachable state, so jump is never enabled (cmc --spec passes).  But
# TypeOK /\ flag admits x = 3, y = 1, from which jump reaches x = 4,
# outside 0 .. 3, where flag still holds: only TypeOK, which is part of
# what is claimed, fails there.  cmc --check-inductive, TLC and Apalache
# must all report that counterexample to induction.

module escape

var x : 0 .. 3
var y : 0 .. 1
init x == 0 and y == 0

action inc:
  when x < 3 and y == 0
  x' = x + 1

action jump:
  when y == 1
  x' = x + 1

deadlock = off

invariant flag [inductive]: y <= 1
