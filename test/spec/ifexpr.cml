# test/spec/ifexpr.cml: TLA+'s IF-THEN-ELSE in .cml.  The branch not
# taken is never evaluated, as in TLC: at x = 0 the division in the
# else branch is not reached.  The else branch extends as far right as
# it can, so `if ... else x + 1` adds inside the branch.  make
# check-emit-tla checks the counts against TLC on the emitted module.

module ifexpr

const N = 4

var x : 0 .. N
var y : 0 .. 2 * N

init x == 0 and y == 0

action step:
  when x < N
  x' = x + 1
  y' = if x == 0 then 0 else N / x + (if x mod 2 == 0 then 1 else 0)

action back:
  when x > 0 and (if y > 2 then TRUE else x == N)
  x' = x - 1

invariant bounded: y <= if x == 0 then N else 2 * N
