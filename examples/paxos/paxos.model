# examples/paxos/paxos.c, single-decree Paxos, checked as it ships.
# Two proposers (nodes 0, 1) and three acceptors (nodes 2, 3, 4), each a
# process; cmc is the network between them.  node[0][7] and node[1][7]
# are the proposers' decided values (0 = none; a crashed proposer that
# never decided has no state, so the byte reads -1, also "none").
#
#   cc -no-pie -o paxos examples/paxos/paxos.c
#   cmc --model-file examples/paxos/paxos.model --binary ./paxos
#
# Add crashes and drops to search harder (see the README):
#   cmc --model-file examples/paxos/paxos.model --binary ./paxos --crashes 1 --drops 1
[target]
nodes = 5

[fields]
decided = 7      # node[i].decided: a proposer's decided value (0 = none)

[invariants]
# Agreement: the one safety property of single-decree Paxos.  No two
# proposers decide different values.  Written over all pairs of nodes;
# only proposers (0, 1) report a decided byte, and an acceptor's state
# is shorter so node[acceptor].decided reads -1 ("none"), which the
# `<= 0` guard excludes.  This maps to the consistency theorem of
# Lamport's Paxos (the Voting refinement in tlaplus/Examples): at most
# one value is ever chosen.  Checked in every reachable state, including
# after a crash (when a node's state is what it made durable).
agreement = "all i in nodes : all j in nodes : node[i].decided <= 0 or node[j].decided <= 0 or node[i].decided == node[j].decided"
