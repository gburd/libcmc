# examples/raft/raft.c: Raft leader election, three nodes.  cmc owns the
# election timers and the message order, so it explores every race.
# node[i] = [role][currentTerm][votedFor+1]; role 2 = leader.
#
#   cc -no-pie -o raft examples/raft/raft.c
#   cmc --model-file examples/raft/raft.model --binary ./raft
[target]
nodes = 3

[environment]
timeouts = 2        # two nodes may time out and stand for election

[fields]
role = 0            # node[i].role: 2 = leader
term = 1            # node[i].term: currentTerm

[invariants]
# Election Safety: at most one leader per term.  Over all pairs of
# nodes, two leaders never share a term.  This is Raft's Election Safety
# property (Ongaro & Ousterhout, raft.tla / dissertation appendix B),
# stated here as it reads there rather than hand-expanded per pair.
election_safety = "all i in nodes : all j in nodes : i == j or not (node[i].role == 2 and node[j].role == 2 and node[i].term == node[j].term)"
