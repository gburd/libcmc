# examples/spec/paxos.cml: single-decree Paxos as an abstract model,
# extending the shared consensus base.  It inherits Agreement (at most
# one value chosen) unchanged; its own actions drive `chosen` the Paxos
# way -- a value is chosen once a QUORUM of acceptors has voted for it at
# one ballot.
#
# Voting style (Lamport, Paxos.tla / the Voting refinement): each
# acceptor, at each ballot, may vote for one value, and only for a value
# that is "safe" at that ballot.  Here, kept small (3 acceptors, 2
# ballots, 2 values), the safety is enforced by the guard on `vote`.
#
#   cmc --spec examples/spec/paxos.cml
#   cmc --spec examples/spec/paxos.cml --define BUG     (unsafe: double vote)

module paxos
extends consensus

const A = 3                     # acceptors 0 .. A-1
const B = 2                     # ballots 1 .. B
const Q = 2                     # a quorum majority of A

# voted[a] encodes acceptor a's vote: 0 = none, else value*10 + ballot
# (so value v at ballot b is v*10 + b; decoded by / 10 and mod 10)
var voted : [0 .. A-1 -> 0 .. 99]

init voted == [a in 0 .. A-1 -> 0]

# an acceptor with no vote casts one for value v at ballot b, but only if
# v is safe: no acceptor has already voted for a DIFFERENT value at a
# ballot >= b (the Paxos safety condition, simplified to this bound)
action vote(a in 0 .. A-1, v in 1 .. V, b in 1 .. B):
  when voted[a] == 0 and (count c in 0 .. A-1 : voted[c] != 0 and (voted[c] mod 10) >= b and ((voted[c] - (voted[c] mod 10)) / 10) != v) == 0
  voted' = [voted except [a] = v * 10 + b]

# the planted bug: an acceptor votes again, for a different value, with
# no safety check -- two values can then each reach a quorum
action vote_bug(a in 0 .. A-1, v in 1 .. V, b in 1 .. B) [BUG]:
  when (voted[a] mod 10) != b
  voted' = [voted except [a] = v * 10 + b]

# a value v is chosen once a quorum of acceptors voted for it at some
# common ballot b
action choose(v in 1 .. V, b in 1 .. B):
  when (count a in 0 .. A-1 : voted[a] == v * 10 + b) >= Q
  chosen' = [chosen except [v] = 1]
