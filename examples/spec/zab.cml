# examples/spec/zab.cml: ZooKeeper Atomic Broadcast (Zab) as an abstract
# model: epochs, the discovery phase that picks a new leader's initial
# history from a quorum, synchronisation of followers to it, broadcast
# of proposals, and a committed prefix per epoch.
#
# Reference: Flavio Junqueira, Benjamin Reed, Marco Serafini, "Zab:
#   High-performance broadcast for primary-backup systems", DSN 2011,
#   and Apache ZooKeeper's Zab.tla (zookeeper-specifications).  The
#   phases follow the paper: in discovery a follower accepts a new epoch
#   (ACKEPOCH) and reports its current epoch and history; the leader of
#   epoch e takes the history of the most up-to-date member of a quorum
#   (largest current epoch, then longest history) as its initial
#   history; in synchronisation followers adopt that history (NEWLEADER,
#   ACK-LD), and a quorum of them establishes the epoch and commits it;
#   in broadcast the leader proposes, followers acknowledge, and the
#   leader commits a prefix acknowledged by a quorum.
#
# Histories.  A history holds at most two transactions.  A transaction
# is named by the epoch that proposed it, so a history is the pair
# (z1, z2) of those epochs (0 = no transaction), encoded z1*K + z2 with
# K = E + 1.  The .cml has no operator definitions, so "p is a prefix
# of q" is written out inline wherever it is needed: p == q, or p == 0,
# or p holds one transaction and q starts with it (p mod K == 0 and
# q - (q mod K) == p).  Among followers with the same
# current epoch the histories are prefixes of one another, so comparing
# currentEpoch*K*K + history picks the longest one, as Zab's
# (currentEpoch, lastZxid) order does on the reachable states.
#
# Messages are function variables keyed (e-1)*S + s for server s and
# epoch e: ack1/rCE/rH an ACKEPOCH with the reported current epoch and
# history, ackLD an ACK-LD, ackH the longest history s acknowledged in
# epoch e.  lst[e] is the state of epoch e's leader (0 none, 1 initial
# history chosen, 2 established), lh[e] its history, cm[e] the prefix
# it has committed.
#
# The safety property, committed_prefix, is Zab's agreement and total
# order on the committed transactions: of two epochs' committed
# prefixes, one is a prefix of the other.
#
# What is abstracted away: 3 servers, 2 epochs, histories of at most two
# transactions, no FOLLOWERINFO or leader election messages (a leader
# for epoch e is whoever completes discovery for e, at most one per
# epoch), no crashes or restarts (a server that falls silent is modelled
# by never taking its next step), no message loss, and synchronisation
# as one step that replaces the follower's history (DIFF, TRUNC and SNAP
# are not distinguished).  Delivery to the application is not modelled;
# commit is the leader's decision.
#
# -DBUG: newleader_bug takes the initial history of any member of the
# discovery quorum instead of the most up-to-date one, so a new leader
# can miss a transaction the previous epoch committed.
#
#   cmc --spec examples/spec/zab.cml
#   cmc --spec examples/spec/zab.cml --define BUG   (stale initial history)

module zab

const S = 3                     # servers 0 .. S-1
const E = 2                     # epochs 1 .. E (0 = none)
const Q = 2                     # quorum size, a majority of S
const K = E + 1                 # history encoding base

# server state: accepted epoch, current epoch, history
var aE : [0 .. S-1 -> 0 .. E]
var cE : [0 .. S-1 -> 0 .. E]
var h : [0 .. S-1 -> 0 .. K*K-1]

# messages, keyed (e-1)*S + s
var ack1 : [0 .. S*E-1 -> 0 .. 1]
var rCE : [0 .. S*E-1 -> 0 .. E]
var rH : [0 .. S*E-1 -> 0 .. K*K-1]
var ackLD : [0 .. S*E-1 -> 0 .. 1]
var ackH : [0 .. S*E-1 -> 0 .. K*K-1]

# the leader of each epoch
var lst : [1 .. E -> 0 .. 2]
var lh : [1 .. E -> 0 .. K*K-1]
var cm : [1 .. E -> 0 .. K*K-1]

init aE == [s in 0 .. S-1 -> 0]
init cE == [s in 0 .. S-1 -> 0]
init h == [s in 0 .. S-1 -> 0]
init ack1 == [k in 0 .. S*E-1 -> 0]
init rCE == [k in 0 .. S*E-1 -> 0]
init rH == [k in 0 .. S*E-1 -> 0]
init ackLD == [k in 0 .. S*E-1 -> 0]
init ackH == [k in 0 .. S*E-1 -> 0]
init lst == [e in 1 .. E -> 0]
init lh == [e in 1 .. E -> 0]
init cm == [e in 1 .. E -> 0]

# discovery: server s accepts epoch e, above any it accepted before, and
# reports its current epoch and history (ACKEPOCH).
action ackepoch(s in 0 .. S-1, e in 1 .. E):
  when e > aE[s]
  aE' = [aE except [s] = e]
  ack1' = [ack1 except [(e-1)*S + s] = 1]
  rCE' = [rCE except [(e-1)*S + s] = cE[s]]
  rH' = [rH except [(e-1)*S + s] = h[s]]

# discovery ends: with ACKEPOCHs from a quorum in which server m is the
# most up-to-date, the leader of epoch e takes m's history.
action newleader(e in 1 .. E, m in 0 .. S-1):
  when lst[e] == 0 and ack1[(e-1)*S + m] == 1 and (count n in 0 .. S-1 : ack1[(e-1)*S + n] == 1 and rCE[(e-1)*S + n]*K*K + rH[(e-1)*S + n] <= rCE[(e-1)*S + m]*K*K + rH[(e-1)*S + m]) >= Q
  lst' = [lst except [e] = 1]
  lh' = [lh except [e] = rH[(e-1)*S + m]]

# synchronisation: a follower that accepted epoch e adopts the leader's
# history, makes e its current epoch and acknowledges (ACK-LD).  It may
# do so after the epoch is established, as a late follower does.
action ackld(s in 0 .. S-1, e in 1 .. E):
  when lst[e] >= 1 and aE[s] == e and cE[s] < e
  cE' = [cE except [s] = e]
  h' = [h except [s] = lh[e]]
  ackLD' = [ackLD except [(e-1)*S + s] = 1]
  ackH' = [ackH except [(e-1)*S + s] = lh[e]]

# a quorum of ACK-LDs establishes epoch e and commits its initial
# history.
action establish(e in 1 .. E):
  when lst[e] == 1 and (count s in 0 .. S-1 : ackLD[(e-1)*S + s] == 1) >= Q
  lst' = [lst except [e] = 2]
  cm' = [cm except [e] = lh[e]]

# broadcast: the established leader appends a transaction of epoch e,
# giving history n: (e, 0) from the empty history, or (z1, e) from (z1).
action propose(e in 1 .. E, n in 1 .. K*K-1):
  when lst[e] == 2 and ((lh[e] == 0 and n == e*K) or (lh[e] != 0 and lh[e] mod K == 0 and n == lh[e] + e))
  lh' = [lh except [e] = n]

# a follower in epoch e acknowledges the leader's proposals so far.
action ack(s in 0 .. S-1, e in 1 .. E):
  when lst[e] == 2 and aE[s] == e and cE[s] == e and h[s] != lh[e]
  h' = [h except [s] = lh[e]]
  ackH' = [ackH except [(e-1)*S + s] = lh[e]]

# the leader commits a longer prefix p of its history once a quorum has
# acknowledged a history that extends p.
action commit(e in 1 .. E, p in 1 .. K*K-1):
  when lst[e] == 2 and p != cm[e] and (cm[e] == 0 or (cm[e] mod K == 0 and p - (p mod K) == cm[e])) and (p == lh[e] or (p mod K == 0 and lh[e] - (lh[e] mod K) == p)) and (count s in 0 .. S-1 : p == ackH[(e-1)*S + s] or (p mod K == 0 and ackH[(e-1)*S + s] - (ackH[(e-1)*S + s] mod K) == p)) >= Q
  cm' = [cm except [e] = p]

# the planted bug: discovery takes the history of any quorum member.
action newleader_bug(e in 1 .. E, m in 0 .. S-1) [BUG]:
  when lst[e] == 0 and ack1[(e-1)*S + m] == 1 and (count n in 0 .. S-1 : ack1[(e-1)*S + n] == 1) >= Q
  lst' = [lst except [e] = 1]
  lh' = [lh except [e] = rH[(e-1)*S + m]]

# agreement and total order on what is committed: of two epochs'
# committed prefixes, one is a prefix of the other.
invariant committed_prefix: all x in 1 .. E : all y in 1 .. E : cm[x] == 0 or cm[x] == cm[y] or (cm[x] mod K == 0 and cm[y] - (cm[y] mod K) == cm[x]) or cm[y] == 0 or (cm[y] mod K == 0 and cm[x] - (cm[x] mod K) == cm[y])

# the step of Zab's argument for primary integrity that discovery must
# provide: once epoch y's leader has chosen its initial history, that
# history extends every prefix committed in an earlier epoch x.
invariant initial_history: all x in 1 .. E : all y in 1 .. E : not (x < y and lst[y] >= 1) or cm[x] == 0 or cm[x] == lh[y] or (cm[x] mod K == 0 and lh[y] - (lh[y] mod K) == cm[x])
