# examples/zab/zab.c: ZooKeeper Atomic Broadcast.  The leader commits
# and acknowledges a client transaction only after a quorum has stored
# it; a committed transaction must never be lost.  node[i] = [epoch]
# [value]; a crash keeps the durable record.
#
#   cc -no-pie -o zab examples/zab/zab.c
#   cmc --model-file examples/zab/zab.model --binary ./zab --crashes 1
[target]
nodes = 3

[environment]
client_write = 7        # a client submits transaction 7 to the leader (node 0)
crashes = 1             # a node may crash

[invariants]
# No lost commit: every acknowledged (committed) transaction is still
# held by some node.  Underlies ZAB's Agreement (apache/zookeeper
# Zab.tla): a delivered transaction survives.
no_lost_commit = "all r in replies : some j in nodes : r.val in node[j]"
